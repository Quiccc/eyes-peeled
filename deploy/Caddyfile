# Caddy gets and renews the Let's Encrypt certificate for API_DOMAIN by itself.
{$API_DOMAIN} {
	encode zstd gzip
	# Static pages the stores link to (privacy policy, terms), from deploy/site/.
	handle /privacy {
		root * /srv/site
		rewrite * /privacy.html
		file_server
	}
	handle /terms {
		root * /srv/site
		rewrite * /terms.html
		file_server
	}
	# AdMob's seller list (deploy/site/app-ads.txt).
	handle /app-ads.txt {
		root * /srv/site
		file_server
	}
	handle {
		# Photos are at most 3.75 MB and JSON bodies 100 KB; refuse anything bigger before it reaches the api.
		request_body {
			max_size 5MB
		}
		reverse_proxy api:4000
	}
}

# The bare domain the store listings link to: privacy policy and AdMob's app-ads.txt
# (AdMob only looks for app-ads.txt on the root domain of the developer website).
{$SITE_DOMAIN} {
	encode zstd gzip
	root * /srv/site
	handle /privacy {
		rewrite * /privacy.html
		file_server
	}
	handle /terms {
		rewrite * /terms.html
		file_server
	}
	handle /app-ads.txt {
		file_server
	}
	handle {
		redir * /privacy
	}
}
