# Copy to deploy/.env on the VPS and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -hex 32
# The server refuses to start on any `change-me` value.

# Domain whose DNS A record points at this VPS. Caddy gets the HTTPS certificate for it.
API_DOMAIN=api.example.com
# Bare domain for the privacy policy and app-ads.txt (A record to this VPS too). Optional.
SITE_DOMAIN=example.com
POSTGRES_PASSWORD=change-me

# --- API secrets (see server/.env.example for what each does) ---
JWT_SECRET=change-me
FILE_URL_SECRET=change-me
ANTHROPIC_API_KEY=change-me
VERIFY_MODEL=claude-haiku-5-5
VERIFY_MIN_CONFIDENCE=0.7

REVENUECAT_SECRET_KEY=
# At least 32 characters, like ADMIN_TOKEN: it decides who gets Premium.
REVENUECAT_WEBHOOK_AUTH=change-me

APPLE_BUNDLE_ID=com.eyespeeled.app
# Optional: Sign in with Apple token revocation on account deletion (Apple requires it).
# developer.apple.com → Keys → a key with "Sign in with Apple". Paste the .p8 contents on one line with \n for newlines.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

GOOGLE_WEB_CLIENT_ID=

# Admin panel at https://API_DOMAIN/admin-panel/. At least 32 characters (openssl rand -hex 32);
# the server refuses to start with a shorter one. Leave empty to turn the panel off.
ADMIN_TOKEN=change-me
AUTO_SCHEDULE=true
MIN_APP_VERSION=
LOG_LEVEL=info
