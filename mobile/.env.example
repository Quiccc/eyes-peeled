# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the app — never put secrets here.

# Your backend base URL (no trailing slash). Leave empty to run against the in-app mock API.
# Local server (../server/): on a real phone use your computer's LAN IP, e.g. http://192.168.1.20:4000
# (Android emulator: http://10.0.2.2:4000, iOS simulator: http://localhost:4000)
# Production: https://api.eyespeeled.com
EXPO_PUBLIC_API_URL=
# Force the mock API even when EXPO_PUBLIC_API_URL is set.
EXPO_PUBLIC_USE_MOCK_API=true
# Dev builds only: sign in to a local server (started with AUTH_DEV_LOGIN=true) as this test user,
# skipping Apple/Google. Use a different name on each device to test friends. Ignored in release builds.
EXPO_PUBLIC_DEV_LOGIN=
# Mock only: roll the "day" every N seconds to test the reset countdown (0 = real UTC midnight).
EXPO_PUBLIC_MOCK_RESET_IN_SECONDS=0

# Google Sign-In (Google Cloud console → OAuth client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# AdMob interstitial unit IDs for production builds (test IDs are used in dev automatically)
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=

# RevenueCat public SDK keys (Project settings → API keys → app-specific keys). Premium = no ads + Expert word.
# Use RevenueCat's Test Store key in development. Leave empty with the mock API to simulate purchases.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
