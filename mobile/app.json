{
  "expo": {
    "name": "Eyes Peeled",
    "slug": "eyes-peeled",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eyespeeled",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./locales-native/en.json",
      "es": "./locales-native/es.json",
      "pt-BR": "./locales-native/pt-BR.json",
      "fr": "./locales-native/fr.json",
      "de": "./locales-native/de.json",
      "it": "./locales-native/it.json",
      "tr": "./locales-native/tr.json",
      "ru": "./locales-native/ru.json",
      "id": "./locales-native/id.json",
      "hi": "./locales-native/hi.json",
      "ja": "./locales-native/ja.json",
      "ko": "./locales-native/ko.json",
      "zh-Hans": "./locales-native/zh-Hans.json"
    },
    "ios": {
      "bundleIdentifier": "com.eyespeeled.app",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.eyespeeled.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#FF8A00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "com.google.android.gms.permission.AD_ID"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/with-upload-signing",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "es", "pt-BR", "fr", "de", "it", "tr", "ru", "id", "hi", "ja", "ko", "zh-Hans"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF8A00",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Eyes Peeled uses your camera to photograph the daily words you find and to take your profile picture.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Eyes Peeled uses your photos so you can choose a profile picture.",
          "cameraPermission": "Eyes Peeled uses your camera to photograph the daily words you find and to take your profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/nunito/400Regular/Nunito_400Regular.ttf",
              "./node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
              "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf",
              "./node_modules/@expo-google-fonts/nunito/900Black/Nunito_900Black.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Nunito",
                "fontDefinitions": [
                  { "path": "./node_modules/@expo-google-fonts/nunito/400Regular/Nunito_400Regular.ttf", "weight": 400 },
                  { "path": "./node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf", "weight": 700 },
                  { "path": "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf", "weight": 800 },
                  { "path": "./node_modules/@expo-google-fonts/nunito/900Black/Nunito_900Black.ttf", "weight": 900 }
                ]
              }
            ]
          }
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier is used to show you more relevant ads, which keep Eyes Peeled free."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5078516573680218~3997969535",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2c8a5fad-07f0-4092-a899-6aac50f3f0f7"
      }
    },
    "owner": "eyes-peeled"
  }
}
