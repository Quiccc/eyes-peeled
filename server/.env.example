# Copy to server/.env. Never commit the real file.

PORT=4000
# Base URL the app reaches this server at; used to build signed photo URLs.
# On a real phone use your computer's LAN IP, e.g. http://192.168.1.20:4000
PUBLIC_BASE_URL=http://localhost:4000

# Empty = embedded Postgres (PGlite) stored in server/data/db. Set to use a real Postgres server.
DATABASE_URL=

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=change-me-dev-jwt-secret-at-least-32-chars
FILE_URL_SECRET=change-me-dev-file-secret-at-least-32-chars

# Sign-in verification
APPLE_BUNDLE_ID=com.wordhunt.app
GOOGLE_WEB_CLIENT_ID=
# Dev only: accept idToken "dev:<name>" to sign in without Apple/Google. Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN=true

# YOLO service (yolo/). Empty = stub verifier that accepts ~60% of photos at random.
YOLO_URL=
YOLO_KEY=change-me-yolo-key
YOLO_MIN_CONFIDENCE=0.5

# RevenueCat. Empty secret key in dev = /me/purchases/sync grants Premium (like the mock).
REVENUECAT_SECRET_KEY=
# The exact Authorization header value you configure on the RevenueCat webhook.
REVENUECAT_WEBHOOK_AUTH=

# Bearer token for /admin/* and the admin panel (admin/, served at /admin-panel/). Empty = admin off.
ADMIN_TOKEN=
# Where the built admin panel lives (npm run build in admin/).
ADMIN_PANEL_DIR=../admin/dist
# true = during the 1st-7th of each month, plan next month's empty days automatically.
AUTO_SCHEDULE=false

# Reject apps older than this with 426 upgrade_required. Empty = no check.
MIN_APP_VERSION=
